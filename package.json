{
  "name": "akazwz-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cf build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint",
    "deploy": "cf deploy"
  },
  "dependencies": {
    "@solidjs/meta": "1.0.0-next.2",
    "@solidjs/router": "2.0.0-next.44",
    "@solidjs/web": "2.0.0-rc.21",
    "@stylexjs/stylex": "0.19.1",
    "solid-js": "2.0.0-rc.21"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.11",
    "@markdoc/markdoc": "0.5.11",
    "@solidjs/diagnostics": "2.0.0-rc.21",
    "@solidjs/vite-plugin": "3.0.0-next.56",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "26.6.6",
    "cf": "1.0.0-beta.27",
    "filesystem-routing": "0.4.2",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-tsgolint": "7.0.2005",
    "prerender-crawler": "0.3.0",
    "typescript": "7.0.2",
    "unplugin": "3.7.0",
    "vite": "8.3.5"
  },
  "browserslist": [
    "baseline widely available"
  ],
