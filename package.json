  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-67fa336fd",
    "@markdoc/markdoc": "0.5.10",
    "@solidjs/diagnostics": "2.0.0-rc.15",
    "@solidjs/vite-plugin": "3.0.0-next.50",
    "@stylexjs/unplugin": "0.19.1",
    "@types/node": "26.6.5",
    "cf": "1.0.0-beta.17",
    "filesystem-routing": "0.4.0",
    "oxfmt": "0.73.0",
